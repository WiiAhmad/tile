TELOXIDE_TOKEN=

III_URL=ws://127.0.0.1:49134

AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6

# Optional endpoint overrides.
# AI_PROVIDER=openai uses the OpenAI Responses API; if OPENAI_API_PATH is omitted, aisdk uses /v1/responses.
# AI_PROVIDER=openai_compatible uses chat-completions-compatible endpoints; if OPENAI_API_PATH is omitted, aisdk uses chat/completions.
# AI_PROVIDER=anthropic uses ANTHROPIC_BASE_URL + ANTHROPIC_API_PATH, default path /messages.
OPENAI_BASE_URL=
OPENAI_API_PATH=
ANTHROPIC_BASE_URL=
ANTHROPIC_API_PATH=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

L0_HISTORY_LIMIT=30
L0_MAX_USER_HISTORY=15
L0_MAX_ASSISTANT_HISTORY=15
L0_SEARCH_LIMIT=10

HEALTH_CHECK_INTERVAL_SECS=60
DB_HEALTH_TIMEOUT_MS=2000
TOOL_AUDIT_LOG_TO_L0=true
MAX_TOOL_FAILURE_RETRIES=5
AI_AGENT_TIMEOUT_SECS=60
AI_AGENT_MAX_TIMEOUT_RETRIES=3

LOG_LEVEL=info
LOG_TO_TERMINAL=true
LOG_TO_JSONL=true
LOG_JSONL_PATH=./logs/bot-events.jsonl
LOG_TO_DATABASE=true
LOG_TO_PUBSUB=true
LOG_PUBSUB_TOPIC=bot.logs
LOG_WEBSOCKET_ENABLED=true
LOG_WEBSOCKET_HOST=127.0.0.1
LOG_WEBSOCKET_PORT=3120
