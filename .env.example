BOT_TOKEN=

AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6

# Optional endpoint overrides.
# AI_BASE_URL and AI_API_PATH apply to whichever AI_PROVIDER is selected.
# If AI_API_PATH is omitted, the selected aisdk provider uses its default API path.
AI_BASE_URL=
AI_API_PATH=
AI_API_KEY=

L0_HISTORY_LIMIT=30
L0_MAX_USER_HISTORY=15
L0_MAX_ASSISTANT_HISTORY=15
L0_SEARCH_LIMIT=10

MAX_TOOL_FAILURE_RETRIES=5
AI_AGENT_TIMEOUT_SECS=60
AI_AGENT_MAX_TIMEOUT_RETRIES=3

LOG_LEVEL=debug
